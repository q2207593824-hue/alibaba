# 本地开发环境配置 - 禁用云端会员服务，加快响应速度
# 所有会员/积分数据仅使用本地 SQLite（backend/data/membership.db）

# 关键：禁用云端积分模式，使用本地会员库
MEMBERSHIP_POINTS_SOURCE=local

# 可选：完全禁用云端同步（不请求 echo-yiwu.cloud）
# MEMBERSHIP_CLOUD_SYNC_ENABLED=0

# 缩短超时时间（秒）
CLOUD_LOGIN_CONNECT_TIMEOUT_SEC=2
CLOUD_LOGIN_READ_TIMEOUT_SEC=5
CLOUD_ME_CONNECT_TIMEOUT_SEC=2
CLOUD_ME_READ_TIMEOUT_SEC=5

# 禁用管理员列表的云端合并（直接返回本地数据）
MEMBERSHIP_ADMIN_USERS_CLOUD_MERGE=no
